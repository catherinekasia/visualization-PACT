# This is for the earning potantial calculation 

import pandas as pd
import numpy as np
from pathlib import Path


SCRIPT_DIR = Path(__file__).resolve().parent
DATA_DIR = SCRIPT_DIR.parent  # .../data/filtered_cia_data


PATH_ECON_STAB = SCRIPT_DIR / "economic_stability_option_c.csv"

OUT_FILE = SCRIPT_DIR / "earning_potential_epi_future.csv"


def detect_country_column(df: pd.DataFrame) -> str:
    candidates = ["COUNTRY", "Country", "country", "Country Name", "country_name", "Entity", "Location", "Name", "name"]
    for c in candidates:
        if c in df.columns:
            return c
    lower_map = {c.lower(): c for c in df.columns}
    for c in candidates:
        if c.lower() in lower_map:
            return lower_map[c.lower()]
    raise KeyError(f"Could not find a country column. Columns:\n{list(df.columns)}")

def find_col(df: pd.DataFrame, any_tokens=(), all_tokens=()):
    for col in df.columns:
        low = col.lower()
        if any_tokens and not any(t in low for t in any_tokens):
            continue
        if all_tokens and not all(t in low for t in all_tokens):
            continue
        return col
    return None

def to_numeric(s: pd.Series) -> pd.Series:
    x = (s.astype(str)
           .str.replace(",", "", regex=False)
           .str.replace("%", "", regex=False)
           .str.strip())
    x = x.replace({"": np.nan, "NA": np.nan, "N/A": np.nan, "nan": np.nan, "None": np.nan})
    return pd.to_numeric(x, errors="coerce")

def minmax(series: pd.Series) -> pd.Series:
    s = to_numeric(series)
    mn = s.min(skipna=True)
    mx = s.max(skipna=True)
    if pd.isna(mn) or pd.isna(mx) or mx == mn:
        return pd.Series(np.nan, index=s.index)
    return (s - mn) / (mx - mn)


def main():
    if not PATH_ECON_STAB.exists():
        raise FileNotFoundError(f"Missing file: {PATH_ECON_STAB}\nEdit PATH_ECON_STAB to your Economic Stability CSV.")

    df = pd.read_csv(PATH_ECON_STAB)

    # Country standardization
    country_col = detect_country_column(df)
    df["COUNTRY_STD"] = df[country_col].astype(str).str.strip().str.upper()

    # Auto-detect required columns
    # Economic Stability column (from your previous script)
    col_E = None
    for c in ["EconomicStability_E", "economicstability_e", "economic_stability_e", "E"]:
        if c in df.columns:
            col_E = c
            break
    if col_E is None:
        # fallback: look for "stability" + maybe "economic"
        col_E = find_col(df, any_tokens=("stability",), all_tokens=("economic",)) or find_col(df, any_tokens=("stability",), all_tokens=())
    if col_E is None:
        raise KeyError("Could not find Economic Stability column (expected something like 'EconomicStability_E').")

    # GDP per capita (normalized good)
    col_gdp = (
        find_col(df, any_tokens=("gdp",), all_tokens=("per", "cap")) or
        find_col(df, any_tokens=("gdp",), all_tokens=("capita",)) or
        find_col(df, any_tokens=("gdp_per_capita", "gdp per capita"), all_tokens=())
    )

    # Unemployment (normalized bad)
    col_unemp = find_col(df, any_tokens=("unemploy",), all_tokens=())

    # GDP growth (normalized good)
    col_growth = (
        find_col(df, any_tokens=("growth",), all_tokens=("gdp",)) or
        find_col(df, any_tokens=("gdp",), all_tokens=("growth",)) or
        find_col(df, any_tokens=("growth",), all_tokens=())
    )

    missing = [name for name, col in [
        ("GDP per capita", col_gdp),
        ("Unemployment", col_unemp),
        ("GDP growth", col_growth),
        ("Economic stability E", col_E),
    ] if col is None]
    if missing:
        print("Available columns:", list(df.columns))
        raise KeyError(f"Missing required columns: {missing}\n"
                       f"Fix by setting col_gdp/col_unemp/col_growth/col_E manually.")
    # this is here just to ensure that we are using correct columns 
    print("Using columns:")
    print("  Country:", country_col)
    print("  GDP per capita:", col_gdp)
    print("  Unemployment:", col_unemp)
    print("  GDP growth:", col_growth)
    print("  Economic stability E:", col_E)

    # Normalize components
    df["GDP_n"] = minmax(df[col_gdp])         
    df["U_n"] = minmax(df[col_unemp])         
    df["G_n"] = minmax(df[col_growth])        

    df["U_good"] = 1 - df["U_n"]

    # Economic Stability E might already be 0..1; if not, normalize safely:
    E_raw = to_numeric(df[col_E])
    if E_raw.max(skipna=True) > 1.5:  # heuristic: looks like 0..100 or similar
        df["E_n"] = minmax(E_raw)
    else:
        df["E_n"] = E_raw

    # Compute EPI_future
    # EPI_future = 100 * sqrt(GDP' * (1-U') * (E * (0.6 + 0.4*G'))) - the general formula 
    core = df["GDP_n"] * df["U_good"] * (df["E_n"] * (0.6 + 0.4 * df["G_n"]))
    df["EPI_future"] = 100.0 * np.sqrt(core)

    # Output
    out = pd.DataFrame({
        "COUNTRY": df["COUNTRY_STD"],
        "GDP_per_capita_raw": to_numeric(df[col_gdp]),
        "Unemployment_raw": to_numeric(df[col_unemp]),
        "GDP_growth_raw": to_numeric(df[col_growth]),
        "EconomicStability_E_raw": to_numeric(df[col_E]),
        "GDP_n": df["GDP_n"],
        "U_good": df["U_good"],
        "G_n": df["G_n"],
        "E_n": df["E_n"],
        "EPI_future": df["EPI_future"],
    })

    out = out.dropna(subset=["EPI_future"]).reset_index(drop=True)
    out.to_csv(OUT_FILE, index=False)

    print("Saved:", OUT_FILE)
    print("Rows:", len(out))


if __name__ == "__main__":
    main()
