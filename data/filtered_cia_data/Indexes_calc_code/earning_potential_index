# This is for the earning potantial calculation 

import pandas as pd
import numpy as np
from pathlib import Path

# The paths to the input data files
SCRIPT_DIR = Path(__file__).resolve().parent
DATA_DIR = SCRIPT_DIR.parent

PATH_ECON_STAB = SCRIPT_DIR / "economic_stability_option_c.csv"
PATH_ECONOMY = DATA_DIR / "economy_data.csv"

OUT_FILE = SCRIPT_DIR / "earning_potential_epi_future.csv"


# Country-column detection + standardization
def detect_country_column(df: pd.DataFrame) -> str:
    candidates = ["COUNTRY", "Country", "country", "Country Name", "country_name", "Entity", "Location", "Name", "name"]
    for c in candidates:
        if c in df.columns:
            return c
    lower_map = {c.lower(): c for c in df.columns}
    for c in candidates:
        if c.lower() in lower_map:
            return lower_map[c.lower()]
    raise KeyError(f"Could not find a country column. Columns:\n{list(df.columns)}")

# Clean numeric conversion
def to_numeric(s: pd.Series) -> pd.Series:
    x = (s.astype(str)
           .str.replace(",", "", regex=False)
           .str.replace("%", "", regex=False)
           .str.strip())
    x = x.replace({"": np.nan, "NA": np.nan, "N/A": np.nan, "nan": np.nan, "None": np.nan})
    return pd.to_numeric(x, errors="coerce")

# Min-max normalization to 0..1
def minmax(series: pd.Series) -> pd.Series:
    s = to_numeric(series)
    mn = s.min(skipna=True)
    mx = s.max(skipna=True)
    if pd.isna(mn) or pd.isna(mx) or mx == mn:
        return pd.Series(np.nan, index=s.index)
    return (s - mn) / (mx - mn)


def main():
    # Cheack the files exist
    if not PATH_ECON_STAB.exists():
        raise FileNotFoundError(f"Missing file: {PATH_ECON_STAB}")
    if not PATH_ECONOMY.exists():
        raise FileNotFoundError(f"Missing file: {PATH_ECONOMY}")

    df_stab = pd.read_csv(PATH_ECON_STAB)
    df_econ = pd.read_csv(PATH_ECONOMY)

    # Country standardization (both files)
    stab_country_col = detect_country_column(df_stab)
    econ_country_col = detect_country_column(df_econ)

    df_stab["COUNTRY_STD"] = df_stab[stab_country_col].astype(str).str.strip().str.upper()
    df_econ["COUNTRY_STD"] = df_econ[econ_country_col].astype(str).str.strip().str.upper()

    # Columns from economy_data.csv (these exist in your printout)
    COL_GDP_PC = "Real_GDP_per_Capita_USD"
    COL_UNEMP  = "Unemployment_Rate_percent"
    COL_GROWTH = "Real_GDP_Growth_Rate_percent"

    # Column from economic stability file
    COL_E = "EconomicStability_E"
    if COL_E not in df_stab.columns:
        raise KeyError(f"Missing column {COL_E} in {PATH_ECON_STAB.name}")

    # Keep only needed columns (avoid duplicates)
    df_econ = df_econ[["COUNTRY_STD", COL_GDP_PC, COL_UNEMP, COL_GROWTH]]
    df_stab = df_stab[["COUNTRY_STD", COL_E]]

    # Merge everything to have one dataset 
    df = df_econ.merge(df_stab, on="COUNTRY_STD", how="inner")

    # Normalize components
    df["GDP_n"] = minmax(df[COL_GDP_PC])         
    df["U_n"]   = minmax(df[COL_UNEMP])         
    df["G_n"]   = minmax(df[COL_GROWTH])        

    # Invert unemployment (lower is better)
    df["U_good"] = 1 - df["U_n"]

    # Economic Stability E might already be 0..1; if not, normalize safely
    E_raw = to_numeric(df[COL_E])
    if E_raw.max(skipna=True) > 1.5:  # looks like 0..100 or similar
        df["E_n"] = minmax(E_raw)
    else:
        df["E_n"] = E_raw

    # Compute EPI_future
    # EPI_future = 100 * sqrt(GDP' * (1-U') * (E * (0.6 + 0.4*G'))) - the general formula 
    core = df["GDP_n"] * df["U_good"] * (df["E_n"] * (0.6 + 0.4 * df["G_n"]))
    df["EPI_future"] = 100.0 * np.sqrt(core)

    # Output
    out = pd.DataFrame({
        "COUNTRY": df["COUNTRY_STD"],
        "GDP_per_capita_raw": to_numeric(df[COL_GDP_PC]),
        "Unemployment_raw": to_numeric(df[COL_UNEMP]),
        "GDP_growth_raw": to_numeric(df[COL_GROWTH]),
        "EconomicStability_E_raw": to_numeric(df[COL_E]),
        "GDP_n": df["GDP_n"],
        "U_good": df["U_good"],
        "G_n": df["G_n"],
        "E_n": df["E_n"],
        "EPI_future": df["EPI_future"],
    })

    out = out.dropna(subset=["EPI_future"]).reset_index(drop=True)
    out.to_csv(OUT_FILE, index=False)

    print("Saved:", OUT_FILE)
    print("Rows:", len(out))
    print(out.head(10))


if __name__ == "__main__":
    main()
