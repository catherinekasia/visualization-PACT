import pandas as pd
import numpy as np

# The paths to the input data files
PEACE_PATH = "visualization-PACT/data/filtered_cia_data/global_peace_index.csv"
TERROR_PATH = "visualization-PACT/data/filtered_cia_data/global_terrorism_index.csv"
CRIME_PATH = "visualization-PACT/data/filtered_cia_data/criminal_index.csv"

OUT_PATH = "visualization-PACT/data/filtered_cia_data/safety_index_risk_focused.csv"

# The function in case names of countries are a bit different (upper/lower case)
def canon_country(x: str) -> str:
    """Canonical country key for joining (uppercased)."""
    if pd.isna(x):
        return np.nan
    return str(x).strip().upper()

def minmax_high_is_worse_to_safe(series: pd.Series) -> pd.Series:
    """
    Convert a metric where higher = worse (terrorism index, criminality index) into a 0..1 safe score where higher = safer.
    Uses min-max scaling, then inverts it:
        safe = 1 - (x - min) / (max - min)

    - Output is relative to the countries present in the dataset (depends on min/max).
    - Non-numeric values become NaN.
    - If the column is empty or constant, non-missing values become 1.0 (neutral safe).
    """
    s = pd.to_numeric(series, errors="coerce")
    mn, mx = s.min(skipna=True), s.max(skipna=True)
    if pd.isna(mn) or pd.isna(mx) or mx == mn:
        return s.apply(lambda v: np.nan if pd.isna(v) else 1.0)
    return 1.0 - (s - mn) / (mx - mn)

def minmax_low_is_worse_to_safe(series: pd.Series) -> pd.Series:
    """Normalize to 0..1 where higher=safer, assuming original lower=worse (higher=better)."""
    s = pd.to_numeric(series, errors="coerce")
    mn, mx = s.min(skipna=True), s.max(skipna=True)
    if pd.isna(mn) or pd.isna(mx) or mx == mn:
        return s.apply(lambda v: np.nan if pd.isna(v) else 1.0)
    return (s - mn) / (mx - mn)

def weighted_mean_rowwise(df_safe: pd.DataFrame, weights: dict, renormalize_missing: bool = True) -> pd.Series:
    """
    Row-wise weighted mean of safe-scores (0..1).
    If renormalize_missing=True: ignores missing components and rescales weights per row.
    """
    cols = list(weights.keys())
    w = pd.Series(weights, dtype=float)

    if not renormalize_missing:
        return (df_safe[cols] * w).sum(axis=1) / w.sum()

    mask = ~df_safe[cols].isna()
    w_mat = mask.mul(w, axis=1)
    w_sum = w_mat.sum(axis=1)
    num = (df_safe[cols].fillna(0) * w_mat).sum(axis=1)
    return num / w_sum.replace(0, np.nan)

# Loading the data 
peace = pd.read_csv(PEACE_PATH)     # Country,peace_index,Change
terror = pd.read_csv(TERROR_PATH)   # Country ,terrorism_index,rank_change
crime = pd.read_csv(CRIME_PATH)     # Country, Criminality_2025,...

# Specifing the columns, to ensure that we don't have a problem from mixing up the columns
peace = peace.rename(columns={c: c.strip() for c in peace.columns})
peace["country_key"] = peace["Country"].map(canon_country)
peace = peace[["country_key", "Country", "peace_index", "Change"]].rename(
    columns={"Country": "country_peace", "Change": "peace_change"}
)

terror = terror.rename(columns={c: c.strip() for c in terror.columns})
# If your terror file uses "country" (lowercase), change "Country" to "country" here
terror["country_key"] = terror["Country"].map(canon_country)
terror = terror[["country_key", "Country", "terrorism_index", "rank_change"]].rename(
    columns={"Country": "country_terror", "rank_change": "terror_rank_change"}
)

crime = crime.rename(columns={c: c.strip() for c in crime.columns})
crime["country_key"] = crime["Country"].map(canon_country)
crime = crime[
    [
        "country_key",
        "Country",
        "Criminality_2025",
        "Score Change 2023 - 2025",
        "Criminality",
        "Criminal markets",
        "Criminal actors",
        "Resilience",
    ]
].rename(
    columns={
        "Country": "country_crime",
        "Criminality_2025": "criminality_2025",
        "Score Change 2023 - 2025": "criminality_change_2023_2025",
        "Criminality": "criminality_components",
        "Criminal markets": "criminal_markets",
        "Criminal actors": "criminal_actors",
        "Resilience": "resilience",
    }
)

# Merge
df = crime.merge(peace, on="country_key", how="outer").merge(terror, on="country_key", how="outer")

# Choose a display name
df["Country"] = (
    df["country_crime"]
    .combine_first(df["country_peace"])
    .combine_first(df["country_terror"])
    .combine_first(df["country_key"])
)

# ---------- Build SAFE scores (0..1, higher=safer) ----------
# Terrorism: higher=worse -> invert
df["terror_safe"] = minmax_high_is_worse_to_safe(df["terrorism_index"])

# Peace index: smaller=better -> still invert (higher value means less peaceful/worse)
df["peace_safe"] = minmax_high_is_worse_to_safe(df["peace_index"])

# Criminality: higher=worse -> invert
df["crime_safe"] = minmax_high_is_worse_to_safe(df["criminality_2025"])

# ---------- Risk-focused Type A weights ----------
weights = {"crime_safe": 0.40, "terror_safe": 0.40, "peace_safe": 0.20}

df["safety_index_risk_focused"] = 100 * weighted_mean_rowwise(df, weights, renormalize_missing=True)

out_cols = [
    "Country",
    "criminality_2025",
    "peace_index",
    "terrorism_index",
    "crime_safe",
    "peace_safe",
    "terror_safe",
    "safety_index_risk_focused",
]

df[out_cols].sort_values("safety_index_risk_focused", ascending=False).to_csv(OUT_PATH, index=False)

print(f"Saved: {OUT_PATH}")
print(df[out_cols].sort_values("safety_index_risk_focused", ascending=False).head(10))
