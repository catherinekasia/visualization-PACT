def detect_country_column(df):
    # compare in lowercase only
    possible = {"country", "country_name", "country name", "name"}
    for col in df.columns:
        if col.strip().lower() in possible:
            return col
    return None

def filter_disabled_countries(df):
    country_col = detect_country_column(df)
    if country_col is None:
        print(" No country column detected.")
        return df

    country_series = (
        df[country_col]
        .astype(str)
        .str.strip()
        .str.upper()
    )

    return df.loc[~country_series.isin(DISABLED_COUNTRIES)].reset_index(drop=True)

def read_csv_robust(path: Path):
    """
    Robust reader:
    - uses Python engine (handles weird quoting better)
    - skips problematic lines
    - collects skipped lines for reporting
    Basically just to see if there are any problems in the input data.
    """
    bad_lines = []

    def bad_line_handler(bad_line):
        # bad_line is a list of strings for that row
        bad_lines.append(",".join(bad_line))
        return None  # skip it

    df = pd.read_csv(
        path,
        engine="python",
        on_bad_lines=bad_line_handler,  
        sep=","
    )
    return df, bad_lines

def main():
    INPUT_DIR = Path("data")
    OUTPUT_DIR = Path("data/filtered_cia_data")
    OUTPUT_DIR.mkdir(parents=True, exist_ok=True)


    # Many prints here are just for confirmation that the process is working correctly
    csv_files = [INPUT_DIR / "communications_data.csv"]

    for file in csv_files:
        if not file.exists():
            print(f" File not found: {file}")
            continue

        df, bad_lines = read_csv_robust(file)

        if bad_lines:
            report_path = OUTPUT_DIR / f"{file.stem}_bad_rows.txt"
            report_path.write_text("\n".join(bad_lines), encoding="utf-8")
            print(f"Skipped {len(bad_lines)} bad rows. Saved to {report_path.name}")

        before = len(df)
        filtered_df = filter_disabled_countries(df)
        after = len(filtered_df)

        out_path = OUTPUT_DIR / file.name
        filtered_df.to_csv(out_path, index=False)

        print(f"{file.name}: {before} → {after} (removed {before - after})")
        print(f"📁 Saved: {out_path}")

    print("\n Filtering complete.")

if __name__ == "__main__":
    main()
